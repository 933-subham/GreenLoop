{
  "expo": {
    "name": "EcoCity Waste Management",
    "slug": "ecocity-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "57.0.0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10b981"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "EcoCity needs camera access to snap real-time unfiltered garbage photos.",
        "NSLocationWhenInUseUsageDescription": "EcoCity needs your location to tag reported garbage for municipal cleanup."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10b981"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBzYTGKD7lk1awjjoE2FFfgZGO9Ii-Vhh0"
        }
      },
      "package": "com.ecocity.waste"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EcoCity to access your camera to capture live garbage photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow EcoCity to use your location to pin waste on the map."
        }
      ]
    ]
  }
}
